{
  "name": "conveymate",
  "version": "0.0.0",
  "scripts": {
    "ng": "bash ../../tools/scripts/with-node24.sh node ./node_modules/@angular/cli/bin/ng.js",
    "start": "npm run start:marketing",
    "sync:marketing-insights": "node ./scripts/sync-marketing-insights.mjs",
    "start:marketing": "npm run sync:marketing-insights && bash ../../tools/scripts/with-node24.sh node ./node_modules/@angular/cli/bin/ng.js serve marketing-site --proxy-config proxy.conf.json --port 4200",
    "start:app": "bash ../../tools/scripts/with-node24.sh node ./node_modules/@angular/cli/bin/ng.js serve app-site --proxy-config proxy.conf.json --port 4201",
    "build": "npm run build:marketing && npm run build:app",
    "build:marketing": "npm run sync:marketing-insights && bash ../../tools/scripts/with-node24.sh node ./node_modules/@angular/cli/bin/ng.js build marketing-site",
    "build:app": "bash ../../tools/scripts/with-node24.sh node ./node_modules/@angular/cli/bin/ng.js build app-site",
    "watch": "npm run sync:marketing-insights && bash ../../tools/scripts/with-node24.sh node ./node_modules/@angular/cli/bin/ng.js build marketing-site --watch --configuration development",
    "test": "npm run test:marketing && npm run test:app",
    "test:marketing": "bash ../../tools/scripts/with-node24.sh node ./node_modules/@angular/cli/bin/ng.js test marketing-site --watch=false",
    "test:app": "bash ../../tools/scripts/with-node24.sh node ./node_modules/@angular/cli/bin/ng.js test app-site --watch=false"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.1.5",
    "@angular/compiler": "^21.1.5",
    "@angular/core": "^21.1.5",
    "@angular/forms": "^21.1.5",
    "@angular/platform-browser": "^21.1.5",
    "@angular/platform-browser-dynamic": "^21.1.5",
    "@angular/platform-server": "^21.1.5",
    "@angular/router": "^21.1.5",
    "@angular/ssr": "^21.1.4",
    "@stripe/stripe-js": "^8.8.0",
    "chart.js": "^4.5.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.5",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^20.19.37",
    "jasmine-core": "^6.0.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "typescript": "~5.9.3"
  }
}
